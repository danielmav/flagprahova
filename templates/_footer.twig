<footer class="fp-footer">
    <div class="container">
        <div class="row g-4 py-5">
            <div class="col-lg-4">
                <img src="{{ base }}/assets/img/logo/flag-prahova.png" alt="" width="118" height="48" class="fp-footer__sigla">
                <p class="mt-3">{{ setari.landing_text|default('') }}</p>
            </div>
            <div class="col-6 col-lg-4">
                <h4>{{ sectiune ? sectiune.titlu : 'Perioade' }}</h4>
                <ul class="list-unstyled">
                    {% if sectiune %}
                        {% for n in arbore|filter(n => n.href != '') %}
                            <li><a href="{{ n.href }}"{% if n.fila_noua %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ n.titlu }}</a></li>
                        {% endfor %}
                        {% if cealalta %}<li class="mt-3"><a class="fp-btn fp-btn--accent fp-footer__cealalta" href="{{ base }}/{{ cealalta.slug }}/">{{ cealalta.titlu }} →</a></li>{% endif %}
                    {% else %}
                        {% for s in sectiuni %}<li><a href="{{ base }}/{{ s.slug }}/">{{ s.titlu }}</a></li>{% endfor %}
                    {% endif %}
                </ul>
            </div>
            {# Coloana de contact apare doar dacă e completată din admin — altfel
               ar rămâne un titlu „Contact" fără nimic sub el. #}
            {% if setari.contact_adresa|default('') or setari.contact_telefon|default('') or setari.contact_email_public|default('') %}
            <div class="col-6 col-lg-4">
                <h4>Contact</h4>
                <address class="mb-0">
                    {% if setari.contact_adresa|default('') %}<p>{{ setari.contact_adresa }}</p>{% endif %}
                    {% if setari.contact_telefon|default('') %}<p><a href="tel:{{ setari.contact_telefon|replace({' ': ''}) }}">{{ setari.contact_telefon }}</a></p>{% endif %}
                    {% if setari.contact_email_public|default('') %}<p><a href="mailto:{{ setari.contact_email_public }}">{{ setari.contact_email_public }}</a></p>{% endif %}
                </address>
            </div>
            {% endif %}
        </div>
        <div class="fp-footer__logos">
            <img src="{{ base }}/assets/img/logo/eu-flag.png" alt="Uniunea Europeană" width="61" height="40">
            <span class="fp-footer__cofin">Cofinanțat de Uniunea Europeană</span>
            <img src="{{ base }}/assets/img/logo/guvernul-romaniei.png" alt="Guvernul României" width="45" height="44">
            {# Sigla programului 2021-2027 nu apare pe paginile perioadei 2014-2020. #}
            {% if sectiune is null or sectiune.slug == '2021-2027' %}
                <img src="{{ base }}/assets/img/logo/2021-2027.png" alt="FLAG Prahova 2021-2027" width="66" height="44">
            {% endif %}
        </div>
        <p class="fp-footer__disclaimer small">{{ setari.footer_text|default('') }}</p>
        <div class="fp-footer__bottom d-flex flex-wrap justify-content-between gap-2">
            <span>© {{ 'now'|date('Y') }} Asociația FLAG Prahova</span>
            <span>Grup de acțiune locală pentru pescuit și acvacultură</span>
        </div>
    </div>
</footer>
