{% extends 'layout.twig' %}
{% block title %}{{ setari.landing_titlu|default('Asociația FLAG Prahova') }}{% endblock %}
{% block description %}{{ setari.landing_text|default('') }}{% endblock %}
{% block jsonld %}
{# Interpolarea directă în `<script>` ar trece prin autoescape-ul HTML, iar un
   `&`, `"` sau `<` dintr-o setare ar ieși ca entitate și ar strica JSON-ul.
   Construim obiectul ca hash Twig și îl serializăm o singură dată. #}
{% set ld = {
    '@context': 'https://schema.org',
    '@type':    'Organization',
    'name':     'Asociația FLAG Prahova',
    'url':      url_public('/'),
    'logo':     url_public('/assets/img/logo/flag-prahova.png')
} %}
{% if setari.contact_telefon|default('') %}{% set ld = ld|merge({'telephone': setari.contact_telefon}) %}{% endif %}
{% if setari.contact_email_public|default('') %}{% set ld = ld|merge({'email': setari.contact_email_public}) %}{% endif %}
<script type="application/ld+json">
{# JSON_HEX_TAG: un `</script>` dintr-o setare nu poate închide elementul. #}
{{ ld|json_encode(constant('JSON_HEX_TAG'))|raw }}
</script>
{% endblock %}
{% block content %}
{# Hero cu fotografii în fundal: trei imagini care se schimbă prin CSS (fără JS);
   `prefers-reduced-motion` oprește tranziția și lasă prima imagine. Textul și
   casetele perioadelor stau în același bloc, peste fotografie. #}
<section class="fp-hero fp-hero--foto fp-hero--landing">
    <div class="fp-hero__slider" aria-hidden="true">
        {% for i in 1..3 %}
        <img class="fp-hero__slide" src="{{ base }}/assets/img/hero/landing-{{ i }}-1920.webp"
             srcset="{{ base }}/assets/img/hero/landing-{{ i }}-960.webp 960w, {{ base }}/assets/img/hero/landing-{{ i }}-1920.webp 1920w"
             sizes="100vw" width="1920" height="823" alt=""
             {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        {% endfor %}
    </div>
    <div class="container fp-hero__continut">
        <div class="fp-hero__text">
            <span class="fp-eyebrow">Grup de acțiune locală pentru pescuit</span>
            <h1 class="mt-3">{{ setari.landing_titlu|default('Asociația FLAG Prahova') }}</h1>
            <p class="fp-lead">{{ setari.landing_text|default('') }}</p>
        </div>
        <span class="fp-eyebrow fp-eyebrow--soft mt-4">Alege perioada de programare</span>
        <div class="row g-4 mt-1">
            {% for s in sectiuni %}
            <div class="col-md-6">
                <a class="fp-card d-block h-100" href="{{ base }}/{{ s.slug }}/">
                    <span class="fp-eyebrow fp-eyebrow--soft">{{ s.slug }}</span>
                    <span class="h3 d-block mt-3">{{ s.titlu }}</span>
                    <p class="mt-2">{{ s.subtitlu }}</p>
                    <span class="fp-btn mt-3">Intră în secțiune</span>
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
